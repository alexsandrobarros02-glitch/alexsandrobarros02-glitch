# --- IA (obrigatório) ---
# Chave da API da Anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo das conversas (padrão: claude-haiku-5-5, o mais barato)
TUTOR_MODEL=claude-haiku-5-5

# --- Banco de dados ---
# Vazio = arquivo local (local.db). Em produção use Turso: libsql://SEU-BANCO.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Login (obrigatório em produção) ---
# Texto aleatório longo, ex.: openssl rand -hex 32
AUTH_SECRET=
# Envio do código por e-mail (https://resend.com). Vazio em dev = código aparece no terminal.
RESEND_API_KEY=
EMAIL_FROM=Fluency <login@seudominio.com.br>

# --- Pix via Asaas ---
# Vazio em dev = modo simulação (botão "Simular pagamento recebido").
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Mesmo token configurado no webhook do painel do Asaas
ASAAS_WEBHOOK_TOKEN=
